#include <winver.h>

1 ICON "rebo.ico"

// Application manifest: DPI awareness (per-monitor v2) and Common Controls v6.
// Resource id 1 + type 24 (RT_MANIFEST) is what the Windows loader looks for.
1 24 "manifest.xml"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040104b0"
        BEGIN
            VALUE "CompanyName",      "TechTouch AI"
            VALUE "FileDescription",  "Rebo - Art Education (Middle School)"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "rebo"
            VALUE "LegalCopyright",   "(c) 2026 TechTouch AI"
            VALUE "OriginalFilename", "Rebo.exe"
            VALUE "ProductName",      "Rebo"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x401, 1200
    END
END

